#!/usr/bin/env python3
"""orch - drive headless coding-agent harnesses for the /orch Claude Code skill.

Stdlib only. All state lives in <project>/.orch/ (git-excluded):

  .orch/current                        id of the active run
  .orch/runs/<run>/run.json            settings (strictness, defaults, goal)
  .orch/runs/<run>/PLAN.md             orchestrator plan + acceptance criteria
  .orch/runs/<run>/workers/<w>/        worker.json, prompt.rN.md, events.rN.jsonl,
                                       stderr.rN.log, inbox.md, watch.json
  <worker cwd>/.orch/WORKLOG-<w>.md    the worker's running documentation

Run `orch help` for the command list.
"""
import argparse
import concurrent.futures
import fnmatch
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILL_DIR = HERE.parent
ORCH_BIN = str(Path(__file__).resolve())

# --------------------------------------------------------------------------
# strictness profiles (1..4) - the single source of truth for thresholds
# --------------------------------------------------------------------------
STRICTNESS = {
    1: dict(name="draft", watch=180, fail_streak=5, loop=4, idle=600, stale_doc=None,
            scope=False, cheat=False, rounds=1, enforce_worklog=False),
    2: dict(name="standard", watch=120, fail_streak=4, loop=3, idle=420, stale_doc=900,
            scope=True, cheat=True, rounds=2, enforce_worklog=True),
    3: dict(name="strict", watch=75, fail_streak=3, loop=3, idle=300, stale_doc=600,
            scope=True, cheat=True, rounds=3, enforce_worklog=True),
    4: dict(name="paranoid", watch=45, fail_streak=2, loop=2, idle=240, stale_doc=420,
            scope=True, cheat=True, rounds=5, enforce_worklog=True),
}

DANGER = re.compile(
    r"rm\s+-[a-z]*r[a-z]*f?\s+(/|~|\$HOME|\.\.?(\s|$))|git\s+push|git\s+reset\s+--hard|"
    r"git\s+clean\s+-[a-z]*f|git\s+checkout\s+--\s+\.|--force\b|--no-verify|push\s+-f\b|"
    r"\bsudo\b|chmod\s+-R\s+777|curl[^|]*\|\s*(ba)?sh|wget[^|]*\|\s*(ba)?sh|"
    r"DROP\s+(TABLE|DATABASE)|mkfs|dd\s+if=|>\s*/dev/sd|npm\s+publish|twine\s+upload|"
    r"gh\s+(pr\s+merge|release|repo\s+delete)", re.I)
CHEAT = re.compile(
    r"\.skip\(|\bxit\(|\bxdescribe\(|@pytest\.mark\.skip|@unittest\.skip|pytest\.skip\(|"
    r"assert\s+True\b|expect\(true\)\.toBe\(true\)|\|\|\s*true\b|# *type: *ignore|"
    r"@ts-ignore|@ts-nocheck|eslint-disable|# *noqa|#\[allow\(|t\.Skip\(|"
    r"it\.todo\(|test\.todo\(|\bTODO: *implement|NotImplementedError|"
    r"return\s+(True|true|0)\s*#\s*(stub|fake|hack)", re.I)
JUNK = re.compile(r"(^|/)(__pycache__|node_modules|\.pytest_cache|\.mypy_cache|\.ruff_cache|\.venv|venv|"
                  r"dist|build|target|coverage|\.next|\.turbo)/|\.(pyc|pyo|log|tmp)$|\.DS_Store$")
INSPECT = re.compile(r"^\s*(git\s+(status|diff|log|show|branch)|ls|pwd|cat|head|tail|wc|echo|which|tree)\b")
TESTY = re.compile(r"(^|/)(tests?|__tests__|spec)(/|$)|[._-](test|spec)\.[a-z]+$|_test\.go$|test_[^/]*\.py$")
EDIT_TOOLS = {"edit", "write", "multiedit", "notebookedit", "str_replace", "create_file",
              "apply_patch", "replace", "write_file", "edit_file", "patch", "write_to_file",
              "replace_file_content", "multi_replace_file_content"}
READ_TOOLS = {"read", "read_file", "view", "cat", "view_file", "list_dir", "ls", "grep", "glob", "grep_search",
              "find_by_name", "codebase_search", "view_code_item", "search", "list_files", "search_files", "todowrite",
              "todoread", "read_many_files", "list_directory", "search_file_content"}
SHELL_TOOLS = {"bash", "shell", "run_shell_command", "shell_command", "run_command", "exec_command", "terminal", "command"}


def now():
    return time.time()


def hms(t=None):
    return time.strftime("%H:%M:%S", time.localtime(t or now()))


def dur(sec):
    sec = int(max(0, sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m{sec % 60:02d}s"
    return f"{sec // 3600}h{(sec % 3600) // 60:02d}m"


def clip(s, n=160):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def rjson(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return default


def wjson(p, obj):
    p = Path(p)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False))
    os.replace(tmp, p)


def die(msg, code=2):
    print(f"orch: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd, cwd=None, timeout=20):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout,
                           shell=isinstance(cmd, str))
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except Exception as e:  # noqa: BLE001 - report any launch failure
        return 127, str(e)


# --------------------------------------------------------------------------
# harness adapters
# --------------------------------------------------------------------------
class Harness:
    """One CLI coding agent. Subclasses fill in argv building and event parsing."""
    name = ""
    bins = ()
    label = ""
    steer = "restart"          # hook | restart
    effort_levels = ()
    models_hint = ""
    auth_hint = ""
    system_prompt_flag = None  # harness can take the contract as system prompt
    stream = True              # emits a live JSON event stream (False: watch falls back to git diff pulses)
    stderr_sid = None          # regex to find the session id on stderr
    env = {}

    def binary(self):
        for b in self.bins:
            p = shutil.which(b)
            if p:
                return p
        return None

    def version(self, path):
        code, out = sh([path, "--version"], timeout=8)
        line = next((ln for ln in out.splitlines() if ln.strip()), "")
        return clip(line, 60) if code == 0 else "?"

    def auth(self):
        return None  # None = unknown, True/False when checkable cheaply

    def build(self, w, prompt, resume):
        raise NotImplementedError

    def parse(self, obj):
        """Map one JSON event to a list of normalized events (dicts)."""
        return generic_parse(obj)


def _content_text(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(_content_text(x.get("text", x.get("content", ""))) if isinstance(x, dict) else str(x) for x in c)
    if isinstance(c, dict):
        return _content_text(c.get("text") or c.get("content") or "")
    return str(c or "")


def tool_event(name, inp, tid=None):
    """Normalize a tool call. Returns kind shell|edit|read|tool."""
    n = (name or "").lower()
    inp = inp if isinstance(inp, dict) else {"input": inp}
    path = (inp.get("file_path") or inp.get("path") or inp.get("filePath") or inp.get("notebook_path")
            or inp.get("TargetFile") or inp.get("AbsolutePath"))
    if "CommandLine" in inp:
        inp = dict(inp, command=inp["CommandLine"])
    if n in SHELL_TOOLS or "command" in inp and isinstance(inp.get("command"), (str, list)) and n not in EDIT_TOOLS:
        cmd = inp.get("command") or inp.get("cmd")
        if isinstance(cmd, list):
            cmd = " ".join(map(str, cmd))
        return dict(k="shell", cmd=str(cmd), id=tid)
    if n in EDIT_TOOLS or n.endswith("edit") or n.endswith("write"):
        body = " ".join(str(inp.get(x, "")) for x in ("new_string", "content", "new_str", "patch", "input", "edits",
                                                      "CodeContent", "ReplacementContent", "ReplacementChunks"))
        return dict(k="edit", path=str(path or "?"), body=body[:20000], id=tid)
    if n in READ_TOOLS:
        return dict(k="read", path=str(path or "?"), id=tid)
    return dict(k="tool", name=name, arg=clip(json.dumps(inp, ensure_ascii=False), 120), id=tid)


def generic_parse(o):
    """Best effort for unknown JSON event shapes."""
    if not isinstance(o, dict):
        return [dict(k="say", text=str(o))]
    out = []
    sid = (o.get("session_id") or o.get("sessionId") or o.get("sessionID") or o.get("thread_id")
           or o.get("conversation_id") or o.get("conversationId"))
    if sid:
        out.append(dict(k="init", sid=sid))
    t = (o.get("type") or o.get("event") or "").lower()
    if "error" in t:
        out.append(dict(k="error", text=clip(json.dumps(o), 300)))
    elif t in {"result", "done", "complete", "completed", "turn.completed", "finish"}:
        out.append(dict(k="done", ok=not o.get("is_error"), text=_content_text(o.get("result", ""))))
    elif "tool" in t:
        out.append(tool_event(o.get("name") or o.get("tool_name") or o.get("tool"),
                              o.get("input") or o.get("parameters") or o.get("args") or {}))
    else:
        txt = _content_text(o.get("text") or o.get("content") or o.get("message") or "")
        if txt.strip():
            out.append(dict(k="say", text=txt))
    return out


class Claude(Harness):
    name, bins, label = "claude", ("claude",), "Claude Code"
    steer = "hook"
    effort_levels = ("low", "medium", "high", "xhigh", "max")
    models_hint = "aliases: fable, opus, sonnet, haiku (or a full model id)"
    auth_hint = "claude auth status / ANTHROPIC_API_KEY"
    system_prompt_flag = "--append-system-prompt"

    def auth(self):
        if os.environ.get("ANTHROPIC_API_KEY"):
            return True
        code, out = sh(["claude", "auth", "status"], timeout=8)
        if code == 0:
            return "not logged in" not in out.lower() and '"loggedIn": false' not in out
        return None

    def build(self, w, prompt, resume):
        a = [self.binary(), "-p", "--output-format", "stream-json", "--verbose"]
        if w.get("model"):
            a += ["--model", w["model"]]
        if w.get("effort"):
            a += ["--effort", w["effort"]]
        a += ["--permission-mode", w.get("permission_mode") or "bypassPermissions"]
        hook = shlex.quote(ORCH_BIN)
        wd = shlex.quote(w["dir"])
        settings = {"hooks": {
            "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": f"{hook} _hook pre {wd}"}]}],
            "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": f"{hook} _hook post {wd}"}]}],
            "Stop": [{"hooks": [{"type": "command", "command": f"{hook} _hook stop {wd}"}]}],
        }}
        a += ["--settings", json.dumps(settings)]
        if resume:
            a += ["--resume", w["session_id"]]
        else:
            a += [self.system_prompt_flag, w["contract"]]
        a += [prompt]
        return a

    def parse(self, o):
        t = o.get("type")
        if t == "system" and o.get("subtype") == "init":
            return [dict(k="init", sid=o.get("session_id"), model=o.get("model"))]
        if t == "assistant":
            out = []
            for c in (o.get("message") or {}).get("content") or []:
                ct = c.get("type")
                if ct == "text" and c.get("text", "").strip():
                    out.append(dict(k="say", text=c["text"]))
                elif ct == "thinking" and c.get("thinking", "").strip():
                    out.append(dict(k="think", text=c["thinking"]))
                elif ct == "tool_use":
                    out.append(tool_event(c.get("name"), c.get("input"), c.get("id")))
            return out
        if t == "user":
            out = []
            content = (o.get("message") or {}).get("content")
            for c in content if isinstance(content, list) else []:
                if isinstance(c, dict) and c.get("type") == "tool_result":
                    txt = _content_text(c.get("content"))
                    m = re.search(r"[Ee]xit code (\d+)", txt)
                    code = int(m.group(1)) if m else (1 if c.get("is_error") else 0)
                    out.append(dict(k="result", id=c.get("tool_use_id"), exit=code, text=txt))
            return out
        if t == "result":
            return [dict(k="done", ok=not o.get("is_error"), sid=o.get("session_id"),
                         cost=o.get("total_cost_usd"), turns=o.get("num_turns"),
                         text=o.get("result") or o.get("subtype", ""))]
        return []


class Codex(Harness):
    name, bins, label = "codex", ("codex",), "OpenAI Codex CLI"
    effort_levels = ("minimal", "low", "medium", "high", "xhigh")
    models_hint = "e.g. gpt-5.5-codex, gpt-5.5 (`codex debug models`); -c model_provider=oss for local"
    auth_hint = "codex login status / OPENAI_API_KEY"

    def auth(self):
        if os.environ.get("OPENAI_API_KEY") or os.environ.get("CODEX_API_KEY"):
            return True
        code, _ = sh(["codex", "login", "status"], timeout=8)
        return code == 0

    def build(self, w, prompt, resume):
        a = [self.binary(), "exec", "--json", "--skip-git-repo-check"]
        if w.get("model"):
            a += ["-m", w["model"]]
        if w.get("effort"):
            a += ["-c", f"model_reasoning_effort={w['effort']}"]
        if w.get("provider"):
            a += ["-c", f"model_provider={w['provider']}"]
        if w.get("read_only"):
            a += ["-s", "read-only"]
        elif (w.get("permission_mode") or "") == "yolo":
            a += ["--dangerously-bypass-approvals-and-sandbox"]
        else:
            a += ["-s", "workspace-write"]
        if resume:
            a += ["resume", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + [prompt]

    def parse(self, o):
        t = o.get("type") or ""
        if t == "thread.started":
            return [dict(k="init", sid=o.get("thread_id"))]
        if t in ("item.started", "item.completed"):
            it = o.get("item") or {}
            ty = it.get("type") or it.get("item_type")
            if ty == "command_execution":
                if t == "item.started":
                    return [dict(k="shell", cmd=it.get("command", ""), id=it.get("id"))]
                return [dict(k="result", id=it.get("id"), exit=it.get("exit_code") or 0,
                             text=it.get("aggregated_output", ""))]
            if t != "item.completed":
                return []
            if ty in ("agent_message", "assistant_message"):
                return [dict(k="say", text=it.get("text", ""))]
            if ty == "reasoning":
                return [dict(k="think", text=it.get("text", ""))]
            if ty == "file_change":
                return [dict(k="edit", path=c.get("path", "?"), body="") for c in it.get("changes") or []]
            if ty in ("mcp_tool_call", "web_search", "todo_list"):
                return [dict(k="tool", name=ty, arg=clip(json.dumps(it, ensure_ascii=False), 120))]
            if ty == "error":
                return [dict(k="error", text=it.get("message", ""))]
            return []
        if t == "turn.completed":
            return [dict(k="done", ok=True, usage=o.get("usage"), text="")]
        if t in ("turn.failed", "error"):
            err = o.get("error") or {}
            msg = err.get("message") if isinstance(err, dict) else o.get("message")
            out = [dict(k="error", text=msg or json.dumps(o))]
            return out + ([dict(k="done", ok=False, text=msg or "")] if t == "turn.failed" else [])
        return []


class Gemini(Harness):
    name, bins, label = "gemini", ("gemini",), "Google Gemini CLI"
    models_hint = "e.g. gemini-3.1-pro, gemini-3.8-flash (-m); effort only via settings.json thinkingConfig"
    auth_hint = "GEMINI_API_KEY or Google login (~/.gemini)"

    def auth(self):
        return bool(os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
                    or (Path.home() / ".gemini" / "oauth_creds.json").exists()) or None

    def build(self, w, prompt, resume):
        a = [self.binary(), "-o", "stream-json"]
        if w.get("model"):
            a += ["-m", w["model"]]
        a += ["--approval-mode", "plan" if w.get("read_only") else (w.get("permission_mode") or "yolo")]
        if resume:
            a += ["--resume", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + ["-p", prompt]

    def parse(self, o):
        t = o.get("type")
        if t == "init":
            return [dict(k="init", sid=o.get("session_id"), model=o.get("model"))]
        if t == "message" and o.get("role") == "assistant":
            return [dict(k="say", text=o.get("content", ""))]
        if t == "tool_use":
            return [tool_event(o.get("tool_name"), o.get("parameters") or {}, o.get("tool_id"))]
        if t == "tool_result":
            ok = (o.get("status") or "success") == "success"
            return [dict(k="result", id=o.get("tool_id"), exit=0 if ok else 1, text=_content_text(o.get("output", "")))]
        if t == "error":
            return [dict(k="error", text=o.get("message", json.dumps(o)))]
        if t == "result":
            return [dict(k="done", ok=(o.get("status") or "success") == "success", text="", usage=o.get("stats"))]
        return []


class Qwen(Harness):
    name, bins, label = "qwen", ("qwen",), "Qwen Code"
    models_hint = "--model + --auth-type openai|anthropic|gemini (or ~/.qwen settings)"
    auth_hint = "qwen auth status / OPENAI_API_KEY+OPENAI_BASE_URL"

    def build(self, w, prompt, resume):
        a = [self.binary(), "--output-format", "stream-json",
             "--approval-mode", "plan" if w.get("read_only") else (w.get("permission_mode") or "yolo")]
        if w.get("model"):
            a += ["--model", w["model"]]
        if w.get("provider"):
            a += ["--auth-type", w["provider"]]
        if resume:
            a += ["--resume", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + ["-p", prompt]

    parse = Claude.parse  # Claude-style stream-json (system/init, assistant, user, result)


class OpenCode(Harness):
    name, bins, label = "opencode", ("opencode",), "opencode"
    models_hint = "provider/model, e.g. anthropic/claude-sonnet-5 (`opencode models`); effort = --variant"
    auth_hint = "opencode auth list"

    def build(self, w, prompt, resume):
        a = [self.binary(), "run", "--format", "json"]
        if not w.get("read_only"):
            a += ["--auto"]
        if w.get("model"):
            a += ["-m", w["model"]]
        if w.get("effort"):
            a += ["--variant", w["effort"]]
        if resume:
            a += ["-s", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + [prompt]

    def parse(self, o):
        t = o.get("type")
        part = o.get("part") or {}
        sid = o.get("sessionID") or part.get("sessionID")
        out = [dict(k="init", sid=sid)] if sid else []
        if t == "text":
            out.append(dict(k="say", text=part.get("text", "")))
        elif t == "tool_use":
            st = part.get("state") or {}
            out.append(tool_event(part.get("tool"), st.get("input") or {}, part.get("callID")))
            if st.get("status") in ("completed", "error"):
                meta = st.get("metadata") or {}
                code = meta.get("exit", 1 if st.get("status") == "error" else 0)
                out.append(dict(k="result", id=part.get("callID"), exit=code or 0, text=str(st.get("output", ""))))
        elif t == "error":
            out.append(dict(k="error", text=json.dumps(o.get("error") or o)))
        elif t == "step_finish" and part.get("reason") == "stop":
            out.append(dict(k="done", ok=True, cost=part.get("cost"), text=""))
        return out


class CursorAgent(Harness):
    name, bins, label = "cursor", ("cursor-agent", "agent"), "Cursor CLI"
    models_hint = "`agent models` (e.g. gpt-5.5, sonnet-5, composer-2)"
    auth_hint = "agent status / CURSOR_API_KEY"

    def binary(self):
        if shutil.which("cursor-agent"):
            return shutil.which("cursor-agent")
        p = shutil.which("agent")  # generic name: only accept Cursor's
        if p and "cursor" in sh([p, "--help"], timeout=5)[1].lower():
            return p
        return None

    def build(self, w, prompt, resume):
        a = [self.binary(), "-p", "--output-format", "stream-json", "--trust"]
        if not w.get("read_only"):
            a += ["--force"]
        if w.get("model"):
            a += ["--model", w["model"]]
        if resume:
            a += ["--resume", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + [prompt]

    def parse(self, o):
        if o.get("type") == "tool_call":
            tc = o.get("tool_call") or {}
            key = next(iter(tc), "")
            args = (tc.get(key) or {}).get("args") or {}
            if o.get("subtype") == "started":
                n = key.replace("ToolCall", "").lower()
                return [tool_event("bash" if n in ("shell", "terminal") else n, args, o.get("call_id"))]
            res = (tc.get(key) or {}).get("result") or {}
            failed = "error" in json.dumps(res)[:200].lower() or bool((res.get("success") or {}).get("exitCode"))
            return [dict(k="result", id=o.get("call_id"), exit=1 if failed else 0, text=clip(json.dumps(res), 300))]
        return Claude.parse(self, o)


class Amp(Harness):
    name, bins, label = "amp", ("amp",), "Amp"
    effort_levels = ("low", "medium", "high", "ultra")  # amp "mode"
    models_hint = "no model flag: effort selects the mode (-m low|medium|high|ultra)"
    auth_hint = "AMP_API_KEY or amp login"

    def build(self, w, prompt, resume):
        a = [self.binary()]
        if resume:
            a += ["threads", "continue", w["session_id"]]
        a += ["--stream-json", "--dangerously-allow-all"]
        if w.get("effort"):
            a += ["-m", w["effort"]]
        if not resume:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + ["-x", prompt]

    parse = Claude.parse


class Droid(Harness):
    name, bins, label = "droid", ("droid",), "Factory Droid"
    effort_levels = ("low", "medium", "high")
    models_hint = "-m MODEL_ID (droid exec --help)"
    auth_hint = "FACTORY_API_KEY"
    stream = False

    def build(self, w, prompt, resume):
        a = [self.binary(), "exec", "-o", "json", "--auto", "low" if w.get("read_only") else "high"]
        if w.get("model"):
            a += ["-m", w["model"]]
        if w.get("effort"):
            a += ["-r", w["effort"]]
        if resume:
            a += ["-s", w["session_id"]]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + [prompt]


class Copilot(Harness):
    name, bins, label = "copilot", ("copilot",), "GitHub Copilot CLI"
    effort_levels = ("low", "medium", "high", "xhigh", "max")
    models_hint = "--model <id|auto>"
    auth_hint = "COPILOT_GITHUB_TOKEN / GH_TOKEN / copilot login"

    def build(self, w, prompt, resume):
        a = [self.binary(), "-s", "--output-format", "json", "--no-ask-user"]
        if not w.get("read_only"):
            a += ["--allow-all"]
        if w.get("model"):
            a += ["--model", w["model"]]
        if w.get("effort"):
            a += ["--effort", w["effort"]]
        if resume:
            a += [f"--resume={w['session_id']}"]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + ["-p", prompt]


class Goose(Harness):
    name, bins, label = "goose", ("goose",), "Goose"
    models_hint = "--provider X --model Y"
    auth_hint = "goose info --check"
    env = {"GOOSE_MODE": "auto"}

    def build(self, w, prompt, resume):
        w.setdefault("session_id", f"orch-{w['name']}-{int(now())}")  # goose names sessions; id is not streamed
        a = [self.binary(), "run", "--output-format", "stream-json", "-n", w["session_id"]]
        if w.get("provider"):
            a += ["--provider", w["provider"]]
        if w.get("model"):
            a += ["--model", w["model"]]
        if resume:
            a += ["--resume"]
        else:
            prompt = w["contract"] + "\n\n---\n\n" + prompt
        return a + ["-t", prompt]


